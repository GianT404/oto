[Unit]
Description=oto backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oto                        # dedicated service user
EnvironmentFile=/etc/oto/oto.env
ExecStart=/usr/local/bin/oto
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=oto              # writable /var/lib/oto

[Install]
WantedBy=multi-user.target